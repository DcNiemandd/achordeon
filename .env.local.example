# Achordeon local env — copy to `.env.local` and adjust if needed.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored; this example is committed. The same variables drive
# local and deployed builds (CI sets them as repo variables), so there is one
# flow everywhere. `apps/app/tools/gen-supabase.mjs` reads the Supabase pair
# (real process.env wins over this file) and writes src/app/supabase.config.ts
# before build/serve/test; the rest are read by Nx, which loads this file into
# the environment of every task it runs.
#
# The anon key is PUBLIC by design — the browser holds it, RLS is the guard
# (ADR-0003) — so it is safe in an env file. Never put the service_role/secret key here.
#
# The defaults below are the local `supabase start` stack. If your CLI prints a
# different anon key (`supabase status`), paste it here — Kong rejects any other
# key with 403.
#
# Set SUPABASE_URL= (empty) to build with NO backend (offline-only): the
# Audience UI reports itself unavailable instead of erroring.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=

# --- Where the site lives ----------------------------------------------------
#
# Uncommented here only to show the deployed shape; leave them commented unless
# you are reproducing a deploy locally, because the paths below are absolute and
# `nx serve` is happier at its own defaults.
#
# In CI these come from repo VARIABLES (Settings ▸ Secrets and variables ▸
# Actions ▸ Variables), not from any file — the workflow falls back to the same
# values if a variable is unset, so a fork still builds a coherent site.
#
# DOCS_URL is the canonical origin Docusaurus stamps into the sitemap and og
# tags. DOCS_BASE_URL / APP_LINK are the docs site's root and its link to the
# app. APP_BASE_HREF is what the Angular bundle is built with — the workflow
# passes it as `--base-href`, since Nx cannot interpolate env into project.json
# (apps/app/project.json keeps `/app/` as the default for local builds).
#
# DOCS_URL=https://achordeon.eu
# DOCS_BASE_URL=/
# APP_BASE_HREF=/app/
# APP_LINK=/app/

# --- Usage statistics --------------------------------------------------------
#
# The GoatCounter site both webs count into. `/count` under this URL takes a GET
# and answers with a 1x1 GIF, which is the whole beacon — no third-party script
# runs and nothing is read off the visitor's device (docs/privacy.mdx says so, so
# keep it true). Unset means NO counting at all: the app omits the endpoint from
# index.html and the docs omit it from the client module, so a fork or a local
# build sends nothing anywhere.
#
# The app also needs this origin in the CSP's `img-src`, which
# apps/app/tools/gen-index.mjs derives from this same variable — one value, so
# the policy cannot drift from the endpoint.

GOATCOUNTER_URL=https://dcniemandd.goatcounter.com/