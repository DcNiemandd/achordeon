6:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"MusicRecording\",\"name\":\"Pohoda\",\"url\":\"https://plnyzpevnik.cz/zpevnik/sam-sebou/pohoda\",\"description\":\"Letní singl Pohoda vydala slovenská kapela Sám Sebou 23. července 2024 a přizvala si k němu rappera Kaliho. Podle frontmana Matúše Fifika se skladba rodila lehce - vzal do ruky kytaru a píseň byla rychle na světě. Kali po poslechu dema souhlasil a svou část dopsal a nahrál ve studiu. Videoklip natočili Tomáš Malejčík a Marek Šebes na dvou místech: u Palcmanské Maše na Slovensku a u rakouského jezera Neusiedler See. Sám Sebou hraje od roku 2010, tvoří ji bratři Matúš a Marek Fifikovci s bratrancem Róbertem Faithem a textařem Františkem Pavolem a na kontě má pět studiových alb a stovky koncertů na Slovensku i v Česku.\",\"recordingOf\":{\"@type\":\"MusicComposition\",\"name\":\"Pohoda\",\"musicalKey\":\"C dur\"},\"byArtist\":{\"@type\":\"MusicGroup\",\"name\":\"Sám Sebou\",\"url\":\"https://plnyzpevnik.cz/interpreti/sam-sebou\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Domů\",\"item\":\"https://plnyzpevnik.cz\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Zpěvník\",\"item\":\"https://plnyzpevnik.cz/zpevnik\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Sám Sebou\",\"item\":\"https://plnyzpevnik.cz/interpreti/sam-sebou\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Pohoda\",\"item\":\"https://plnyzpevnik.cz/zpevnik/sam-sebou/pohoda\"}]}"}}],["$","$L11",null,{"children":[["$","div",null,{"className":"max-w-[96em] mx-auto px-4 py-8 overflow-x-auto","children":"$L12"}],["$","div",null,{"className":"max-w-[96em] mx-auto px-4 pb-8","children":["$","aside",null,{"className":"rounded-lg border bg-muted/50 p-4 flex flex-col gap