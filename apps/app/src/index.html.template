<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- The plain app name: what the tab says before Angular has booted, and what
         a bookmark of the app root keeps. `DocumentTitle` takes over from the
         first navigation and appends the module, the document, or "Performing". -->
    <title>Achordeon</title>
    <base href="/" />
    <!-- Content Security Policy, generated. GitHub Pages cannot set response
         headers, so the policy has to ride in a meta tag (PRD-INFRASTRUCTURE.md
         §7) — and because it does, the inline scripts below need their sha256 in
         `script-src`. `tools/gen-index.mjs` hashes whatever is in this file and
         writes the finished policy here, so editing a script below can never
         silently break it. -->
    __ACHORDEON_CSP__
    <!-- interactive-widget=resizes-content: when the on-screen keyboard opens,
         shrink the layout above it instead of letting it overlay content. That
         is what keeps the editor and the Source/Render switcher usable with the
         keyboard up, rather than hidden behind it. Chrome/Android honours it;
         other engines fall back to their default and lose nothing. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <!-- Both are generated from one description by tools/gen-app-icons.mjs. The
         .ico carries the 16/32/48 cuts for the tab strip; the SVG is what a
         browser that prefers vector will take instead. -->
    <link rel="icon" type="image/x-icon" href="favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="icons/favicon.svg" />
    <!-- The PWA half of "install the app and use it offline" (Epic 11). The
         manifest is what makes the app installable; the service worker (wired in
         app.config.ts) is what makes it run offline. Relative URLs so one
         manifest serves every locale sub-path — `./` resolves to the sub-path the
         manifest itself was fetched from. -->
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#c13515" />
    <!-- iOS ignores the manifest icons for "Add to Home Screen". -->
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <script>
      // HTTPS or nothing, and FIRST — before the theme stamp reads storage or
      // the bundle mints anything.
      //
      // Plain http is not a secure context, so `crypto.randomUUID` does not
      // exist, and the device id is minted at boot (ADR-0004) — the app dies on
      // the first line it runs rather than degrading. The CSP's
      // `upgrade-insecure-requests` does not save us: it upgrades SUBRESOURCES,
      // never the top-level document, which is why the chunks arrive over https
      // while the page that asked for them is still http.
      //
      // GitHub Pages' "Enforce HTTPS" is the real redirect; this is the belt to
      // its braces, for a typed URL or an old bookmark that arrives while that
      // setting is off (or before a new domain's certificate exists).
      //
      // localhost is exempt: it is already a secure context by definition, and
      // there is no certificate to upgrade to — redirecting would break `nx serve`.
      (function () {
        try {
          if (location.protocol !== 'http:') return;
          var host = location.hostname;
          if (host === 'localhost' || host === '127.0.0.1' || host === '[::1]') {
            return;
          }
          location.replace(
            'https://' +
              location.host +
              location.pathname +
              location.search +
              location.hash,
          );
        } catch (e) {}
      })();
    </script>
    <script>
      // Pre-paint theme stamp (PRD-UI-SHELL.md §6). Angular boots after first
      // paint, so without this a dark-mode user gets a white flash. Mirrors
      // ThemeApplier: 'system' means NO attribute, so the token sheet's bare
      // :root can follow prefers-color-scheme.
      (function () {
        try {
          var theme = localStorage.getItem('achordeon.theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>
    <script>
      // SPA deep-link restore (PRD-INFRASTRUCTURE deploy note). GitHub Pages has
      // no per-app 404, so the site's root 404 page redirects an app deep link
      // like `/app/songs` into `/app/?/songs`; this turns
      // that back into the real path before the router — and the locale redirect
      // below — reads the URL. A normal load has no leading "/" in its query, so
      // this is a no-op then. (github.com/rafgraph/spa-github-pages)
      (function () {
        var l = window.location;
        if (l.search[1] === '/') {
          var decoded = l.search
            .slice(1)
            .split('&')
            .map(function (s) {
              return s.replace(/~and~/g, '&');
            })
            .join('?');
          window.history.replaceState(
            null,
            '',
            l.pathname.slice(0, -1) + decoded + l.hash,
          );
        }
      })();
    </script>
    <!-- No locale script here, deliberately: the language is chosen in `main.ts`
         (PRD-INFRASTRUCTURE.md §11 — one bundle, translations loaded at runtime),
         so there is nothing to decide before the app loads and no sub-path to
         redirect to. `lang` above is the source language; `main.ts` restamps it
         when it boots into another one. -->
  </head>
  <body>
    <app-root></app-root>
  </body>
</html>
