{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/icons/**",
          "/media/**",
          "/locale/*.json",
          "/*.css",
          "/*.js",
          "!/sw.js"
        ]
      }
    },
    {
      "name": "body-face",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/RobotoMono-*.ttf", "/fonts/*.txt"]
      }
    },
    {
      "name": "title-faces",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/fonts/*.ttf", "!/fonts/RobotoMono-*.ttf"]
      }
    }
  ]
}
