// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    // The same map the `achordeon-libs` plugin hands webpack (docusaurus.config.ts).
    // Spelled out rather than inherited from `tsconfig.base.json`: that file sets a
    // workspace-wide `module`/`target` this site does not build under.
    //
    // `@site` is re-declared because `paths` REPLACES the inherited map rather
    // than merging with it — `@docusaurus/tsconfig` defines it, and leaving it out
    // here silently unresolves every `@site/…` import on the site.
    "paths": {
      "@site/*": ["./*"],
      "@achordeon/shared/domain": ["../../libs/shared/domain/src/index.ts"],
      "@achordeon/shared/render-core": [
        "../../libs/shared/render-core/src/index.ts"
      ],
      "@achordeon/shared/chord-theory": [
        "../../libs/shared/chord-theory/src/index.ts"
      ],
      "@achordeon/shared/editor-core": [
        "../../libs/shared/editor-core/src/index.ts"
      ]
    }
  },
  "exclude": [".docusaurus", "build"]
}
